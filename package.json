    "start": "next start",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "@prisma/orm-postgres": "8.0.0-rc.16",
    "alchemy": "2.0.0-beta.78",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "prisma": "8.0.0-rc.21",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
